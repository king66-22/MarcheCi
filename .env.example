# ============================================================
# MarchéCI — VARIABLES D'ENVIRONNEMENT (MODÈLE SANS SECRET)
# Copier en `cp .env.example .env` puis remplir avec des
# VALEURS GÉNÉRÉES. Ne jamais commiter le fichier .env réel.
# ============================================================

# --- PostgreSQL (serveur unique, 4 bases logiques) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
PGCAT_USER=cat_svc
PGCAT_DB=marcheci_catalogue
PGCMD_USER=cmd_svc
PGCMD_DB=marcheci_commandes
PGUSR_USER=usr_svc
PGUSR_DB=marcheci_utilisateurs
PGNTF_USER=ntf_svc
PGNTF_DB=marcheci_notifications
# Mot de passe "owner" utilisé par le script d'initialisation des bases
POSTGRES_OWNER_USER=admin_svc
# POSTGRES_OWNER_PASSWORD → fourni via secret composé, pas ici en clair

# --- URLs internes des services (réseau Docker) ---
CATALOGUE_INTERNAL_URLS=http://catalogue:8000
COMMANDES_INTERNAL_URL=http://commandes:8000
UTILISATEURS_INTERNAL_URL=http://utilisateurs:8000
NOTIFICATIONS_INTERNAL_URL=http://notifications:8000

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
PRODUCTS_CACHE_TTL_SECONDS=60

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_UI_PORT=15672        # publié via gateway uniquement
RABBITMQ_VHOST=/
ORDER_EVENTS_QUEUE=order.created
ORDER_EVENTS_DLQ=order.created.dlq

# --- JWT ---
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
JWT_ISSUER=marcheci
# JWT_SECRET → via secret compose, pas ici

# --- Comptes système ---
SWC_CATALOGUE_USER_EMAIL=svc.catalogue@marcheci.ci
TARGET_SYSTEM_LOGIN_COMPTES_DOCUMENTATION=Voir README § Comptes de test

# --- Frontend (build-time) ---
VITE_API_BASE_URL=/api
VITE_CURRENCY=FCFA
VITE_APP_NAME=MarchéCI

# --- Monitoring ---
ZABBIX_SERVER_MUDDLE_ACTIVE=orders_notmonitored
