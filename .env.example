# ============================================================
# MarchéCI — VARIABLES D'ENVIRONNEMENT (modèle SANS secrets)
# Ne JAMAIS commiter le fichier .env réel (déjà dans .gitignore).
# Génère des mots de passe FORTS : openssl rand -base64 24
# Après configuration, exécuter `.venv/Scripts/python scripts/sync_secrets.py`.
# Compose lit ensuite les secrets depuis le dossier secrets/ ignoré par Git.
# ============================================================

# --- PostgreSQL : serveur unique + 4 bases logiques (owner d'amorçage) ---
POSTGRES_OWNER_USER=admin_svc
POSTGRES_OWNER_PASSWORD=CHANGE_ME_strong

# Par microservice (DB + utilisateur DÉDIÉS — jamais partagés)
PGCAT_DB=marcheci_catalogue
PGCAT_USER=cat_svc
PGCAT_PASSWORD=CHANGE_ME_strong

PGCMD_DB=marcheci_commandes
PGCMD_USER=cmd_svc
PGCMD_PASSWORD=CHANGE_ME_strong

PGUSR_DB=marcheci_utilisateurs
PGUSR_USER=usr_svc
PGUSR_PASSWORD=CHANGE_ME_strong

PGNTF_DB=marcheci_notifications
PGNTF_USER=ntf_svc
PGNTF_PASSWORD=CHANGE_ME_strong

# --- Redis (interne au réseau back) ---
PRODUCTS_CACHE_TTL_SECONDS=60

# --- RabbitMQ ---
RABBITMQ_USER=marcheci
RABBITMQ_PASSWORD=CHANGE_ME_strong

# --- Accès local aux outils de diagnostic (boucle locale 127.0.0.1 uniquement) ---
# pgAdmin / psql : localhost:$POSTGRES_HOST_PORT
POSTGRES_HOST_PORT=5432
# Interface web RabbitMQ : http://localhost:$RABBITMQ_MANAGEMENT_PORT
RABBITMQ_MANAGEMENT_PORT=15672

# --- JWT (HS256) partagé émission (utilisateurs) / vérification (les 4) ---
JWT_SECRET=CHANGE_ME_32_bytes_minimum_random
JWT_ISSUER=marcheci

# --- Comptes spéciaux (créés par le service bootstrap, jamais via l'API) ---
SVC_COMMANDES_EMAIL=svc.commandes@marcheci.ci
SVC_COMMANDES_PASSWORD=CHANGE_ME_strong
ADMIN_EMAIL=admin@marcheci.ci
ADMIN_PASSWORD=CHANGE_ME_strong

# --- Gateway ---
GATEWAY_PORT=80

# --- Supervision (monitoring/zabbix/compose.yaml) ---
MON_WEB_PORT=8090
MON_WEB_BIND=127.0.0.1
MON_ZBX_DB_PASSWORD=CHANGE_ME_strong
ZABBIX_ADMIN_USER=Admin
ZABBIX_ADMIN_PASSWORD=CHANGE_ME_generate_a_unique_secret

# --- Frontend (build Vite dans l'image gateway) ---
VITE_API_BASE_URL=/api
